{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LYVAN Payout",
  "version": "../../../package.json",
  "identifier": "se.lyvan.payout",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LYVAN Payout",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "LYVAN",
    "category": "Finance",
    "copyright": "LYVAN",
    "shortDescription": "Payout calculator for LYVAN consultants",
    "longDescription": "Offline payout calculator for LYVAN: compares five payout models (salaried, revenue share, umbrella, sole trader, own AB) for a given billed revenue. Estimates only, not tax advice.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Swedish", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "sv-SE"
      }
    }
  }
}
